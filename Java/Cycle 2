// brute force approach using HashSet

import java.util.HashSet;

public class Solution {
    public ListNode detectCycle(ListNode head) {
        HashSet<ListNode> visited = new HashSet<>();
        ListNode current = head;
        while (current != null) {
            if (visited.contains(current)) {
                return current; 
            }
            visited.add(current);
            current = current.next;
        }
        return null;
    }
}


//optimal

/**
 * Definition for singly-linked list.
 * class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode(int x) {
 *         val = x;
 *         next = null;
 *     }
 * }
 */
public class Solution {
    public ListNode detectCycle(ListNode head) {
        if(head==null||head.next==null){
            return null;
        }
        ListNode fast=head;
        ListNode slow=head;
        while(fast!=null&&fast.next!=null){
            fast=fast.next.next;
            slow=slow.next;
            if(fast==slow){
                ListNode ptr1=head;
                ListNode ptr2=slow;
                while(ptr1!=ptr2){
                    ptr1=ptr1.next;
                    ptr2=ptr2.next;
                }
                return ptr1;

            }

        }
        return null;
        
    }
}


