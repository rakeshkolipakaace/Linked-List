// brute force sorting

class Solution {
    public static Node insertionSort(Node head_ref) {
        if (head_ref == null || head_ref.next == null) return head_ref;

        ArrayList<Integer> arr = new ArrayList<>();
        Node temp = head_ref;
        while (temp != null) {
            arr.add(temp.data);
            temp = temp.next;
        }

        Collections.sort(arr);

        temp = head_ref;
        int i = 0;
        while (temp != null) {
            temp.data = arr.get(i++);
            temp = temp.next;
        }

        return head_ref;
    }
}
